  const secId = sec.id || "sec_" + Date.now() + "_" + Math.random().toString(36).substr(2, 4);

  const card = document.createElement('div');
  card.className = "section-card";
  card.dataset.sectionId = secId;

  let totalSteps = 8;
  if (sec.chords && sec.chords.length > totalSteps) {
    totalSteps = sec.chords.length;
  }
  if (sec.parts) {
    for (const p of sec.parts) {
      if (p.grid) {
        for (const k in p.grid) {
          if (Array.isArray(p.grid[k]) && p.grid[k].length > totalSteps) {
