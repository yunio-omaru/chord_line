function createStringRowHtml(sIdx, stringNote, part, prevPart, totalSteps = 8) {
  let tds = "";
  for (let step = 0; step < totalSteps; step++) {
    const val = (part && part.grid && part.grid[sIdx] && part.grid[sIdx][step]) ? part.grid[sIdx][step] : "-";
    
    let ghostVal = "";
    if (prevPart && prevPart.grid && prevPart.grid[sIdx] && prevPart.grid[sIdx][step]) {
      ghostVal = prevPart.grid[sIdx][step];
      if (ghostVal === "-") ghostVal = "";
    }

    tds += `
      <td class="tab-cell">
        <div class="tab-input-wrapper">
          <div class="tab-ghost">${ghostVal}</div>
          <input type="text" class="tab-input" data-step="${step}" value="${val}" onchange="formatCapoInput(this)" oninput="updateGhostGuide(this); checkAndExpandColumns(this);">
        </div>
      </td>
    `;
  }

  return `
    <tr>
      <td class="string-control-td">
        <button type="button" class="btn-secondary btn-sm" style="padding:1px 3px; font-size:0.7rem;" onclick="removeSpecificRow(this)">✕</button>
        <select class="string-select">
          ${createNoteOptionsHtml(stringNote)}
        </select>
        <button type="button" class="btn-secondary btn-sm" style="padding:1px 3px; font-size:0.7rem;" onclick="insertStringRow(this)">＋</button>
      </td>
