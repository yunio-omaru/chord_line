    chordThs += `<th class="chord-th"><div class="tab-input-wrapper"><input type="text" class="tab-input chord-input" data-step="${i}" placeholder="コード" value="${val}" oninput="checkAndExpandColumns(this)"></div></th>`;
  }

  card.innerHTML = `
    <div class="part-header" style="margin-bottom:12px;">
      <div style="display:flex; align-items:center;">
        <input type="text" class="section-name" value="${sec.name || '新規セクション'}" style="font-weight:bold; font-size:1.05rem; width:50%;">
        <span class="key-badge" id="key-badge-${secId}">Key: ?</span>
      </div>
      <button type="button" class="btn-danger btn-sm" onclick="removeSection('${secId}')">セクション削除</button>
    </div>

    <div class="tab-grid-wrapper">
      <table class="tab-table">
        <colgroup>${chordCols}</colgroup>
        <thead>
          <tr class="chord-header-row">
            <th class="string-control-td">
              Chord
              <br><button type="button" class="btn-secondary btn-sm" style="font-size:0.65rem; padding:1px 4px; margin-top:2px;" onclick="detectAndSetChords('${secId}')">🪄 自動判定</button>
            </th>
            ${chordThs}
          </tr>
        </thead>
      </table>
    </div>

    <div class="parts-container"></div>

    <button type="button" class="btn-secondary btn-sm" onclick="addPartToSection('${secId}')" style="margin-top:8px;">
      [＋] パート追加 (gt1, gt2等)
    </button>

    <div style="margin-top: 10px;">
      <label style="font-size:0.8rem; color:var(--text-muted);">奏法メモ：</label>
