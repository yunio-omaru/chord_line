}

function checkAndExpandColumns(inputEl) {
  const sCard = inputEl.closest('.section-card');
  if (!sCard) return;

  const step = parseInt(inputEl.dataset.step, 10);
  const chordRow = sCard.querySelector('.chord-header-row');
  const currentTotalSteps = chordRow.querySelectorAll('th').length - 1;

  if (step === currentTotalSteps - 1 && inputEl.value.trim() !== "" && inputEl.value.trim() !== "-") {
    expandSectionStep(sCard, currentTotalSteps);
  }
}

function expandSectionStep(sCard, newStepIdx) {
  const chordTable = sCard.querySelector('.tab-grid-wrapper table');
  const chordColgroup = chordTable.querySelector('colgroup');
  if (chordColgroup) {
    const col = document.createElement('col');
    col.className = 'chord-col';
    chordColgroup.appendChild(col);
  }

  const chordRow = sCard.querySelector('.chord-header-row');
  const th = document.createElement('th');
  th.className = "chord-th";
  th.innerHTML = `<div class="tab-input-wrapper"><input type="text" class="tab-input chord-input" data-step="${newStepIdx}" placeholder="コード" value="" oninput="checkAndExpandColumns(this)"></div>`;
  chordRow.appendChild(th);

  const partCards = sCard.querySelectorAll('.part-card');
  for (const pCard of partCards) {
    const partTable = pCard.querySelector('.tab-grid-wrapper table');
    const partColgroup = partTable.querySelector('colgroup');
    if (partColgroup) {
      const col = document.createElement('col');
      col.className = 'tab-cell-col';
      partColgroup.appendChild(col);
    }

    const rows = pCard.querySelectorAll('tbody tr');
    for (const tr of rows) {
      const td = document.createElement('td');
      td.className = "tab-cell";
      td.innerHTML = `
        <div class="tab-input-wrapper">
          <div class="tab-ghost"></div>
          <input type="text" class="tab-input" data-step="${newStepIdx}" value="-" onchange="formatCapoInput(this)" oninput="updateGhostGuide(this); checkAndExpandColumns(this);">
        </div>
      `;
      tr.appendChild(td);
    }
  }
}

function formatCapoInput(inputEl) {
  const rawVal = inputEl.value.trim();
  const capoVal = parseInt(document.getElementById('song-capo').value || "0", 10);
  if (capoVal <= 0 || !rawVal || rawVal === "-") return;
  if (/\d+\(\d+\)/.test(rawVal)) return;

  const fretNum = parseInt(rawVal, 10);
  if (!isNaN(fretNum) && fretNum > 0) {
    const actualFret = fretNum + capoVal;
    inputEl.value = `${fretNum}(${actualFret})`;
  }
}

function parseNoteIndex(noteStr) {
  if (!noteStr) return 0;
  const cleanStr = noteStr.trim().toUpperCase();
  return NOTE_TO_INDEX[cleanStr] !== undefined ? NOTE_TO_INDEX[cleanStr] : 0;
}

function detectSectionKey(sCard, capoVal) {
  const noteHistogram = {};
  CHROMATIC_SCALE.forEach(n => noteHistogram[n] = 0);

  const partCards = sCard.querySelectorAll('.part-card');
  for (const pCard of partCards) {
    const rows = pCard.querySelectorAll('tbody tr');
    for (const row of rows) {
      const stringNote = row.querySelector('.string-select').value;
      const inputs = row.querySelectorAll('.tab-input');
      inputs.forEach(inp => {
        if (!inp.value || inp.value === "-") return;
        const match = inp.value.match(/^(\d+)/);
        if (match) {
          const fretVal = parseInt(match[1], 10);
          const openIndex = parseNoteIndex(stringNote);
          const absPitch = openIndex + fretVal + capoVal;
          const noteName = CHROMATIC_SCALE[absPitch % 12];
          noteHistogram[noteName] += 1;
        }
      });
    }
  }

  let bestKey = "C";
  let maxScore = -1;

  for (let i = 0; i < 12; i++) {
    const keyRoot = CHROMATIC_SCALE[i];
    let score = 0;
    MAJOR_SCALE_INTERVALS.forEach(interval => {
      const scaleNote = CHROMATIC_SCALE[(i + interval) % 12];
      score += noteHistogram[scaleNote];
    });
    if (score > maxScore) {
      maxScore = score;
      bestKey = keyRoot;
    }
  }
  return bestKey;
}

function detectAndSetChords(secId) {
  const sCard = document.querySelector(`.section-card[data-section-id="${secId}"]`);
  if (!sCard) return;

  const capoVal = parseInt(document.getElementById('song-capo').value || "0", 10);
  const estimatedKey = detectSectionKey(sCard, capoVal);
  const badge = document.getElementById(`key-badge-${secId}`);
  if (badge) badge.innerText = `Key: ${estimatedKey}`;

  const partCards = sCard.querySelectorAll('.part-card');
  const chordInputs = sCard.querySelectorAll('.chord-input');
  const totalSteps = chordInputs.length;

  for (let step = 0; step < totalSteps; step++) {
    const pitchSet = new Set();
    let bassNoteName = "";

    for (const pCard of partCards) {
      const rows = Array.from(pCard.querySelectorAll('tbody tr'));
      for (let rIdx = rows.length - 1; rIdx >= 0; rIdx--) {
        const row = rows[rIdx];
        const stringNote = row.querySelector('.string-select').value;
        const inp = row.querySelector(`.tab-input[data-step="${step}"]`);
        if (!inp || !inp.value || inp.value === "-") continue;

        let fretVal = NaN;
        const match = inp.value.match(/^(\d+)/);
        if (match) fretVal = parseInt(match[1], 10);

        if (!isNaN(fretVal)) {
          const openIndex = parseNoteIndex(stringNote);
          const absolutePitch = openIndex + fretVal + capoVal;
          const noteName = CHROMATIC_SCALE[absolutePitch % 12];
          pitchSet.add(noteName);

          if (bassNoteName === "") bassNoteName = noteName;
        }
      }
    }

    if (pitchSet.size > 0) {
      const detectedChord = analyzeAdvancedChordWithKey(Array.from(pitchSet), bassNoteName, estimatedKey);
      if (chordInputs[step]) chordInputs[step].value = detectedChord;
    }
  }
}

function analyzeAdvancedChordWithKey(notes, bassNote, keyRoot) {
  if (notes.length === 0) return "";
  if (notes.length === 1) return notes[0];

  const chordPatterns = [
    { suffix: "m7", intervals: [3, 7, 10] },
    { suffix: "maj7", intervals: [4, 7, 11] },
    { suffix: "7", intervals: [4, 7, 10] },
    { suffix: "m", intervals: [3, 7] },
    { suffix: "", intervals: [4, 7] },
    { suffix: "add9", intervals: [2, 4, 7] },
    { suffix: "sus4", intervals: [5, 7] },
    { suffix: "sus2", intervals: [2, 7] },
    { suffix: "dim", intervals: [3, 6] },
    { suffix: "5", intervals: [7] }
  ];

  let candidateChords = [];
  for (const root of notes) {
    const rootIdx = CHROMATIC_SCALE.indexOf(root);
    const relativeIntervals = notes
      .map(n => (CHROMATIC_SCALE.indexOf(n) - rootIdx + 12) % 12)
      .filter(i => i !== 0)
      .sort((a,b) => a - b);

    for (const pat of chordPatterns) {
      const isMatch = pat.intervals.every(i => relativeIntervals.includes(i));
      if (isMatch) {
        candidateChords.push({
          root: root,
          suffix: pat.suffix,
          matchCount: pat.intervals.length,
          isBassRoot: (root === bassNote)
        });
        break;
      }
    }
  }

  if (candidateChords.length > 0) {
    candidateChords.sort((a, b) => {
      if (a.isBassRoot !== b.isBassRoot) return a.isBassRoot ? -1 : 1;
      return b.matchCount - a.matchCount;
    });
    const best = candidateChords[0];
    const baseChordName = best.root + best.suffix;
    if (bassNote && bassNote !== best.root) return `${baseChordName}/${bassNote}`;
    return baseChordName;
  }
  return notes.join(",");
}

function updateGhostGuide(inputEl) {
  const wrapper = inputEl.closest('.tab-input-wrapper');
  const ghost = wrapper.querySelector('.tab-ghost');
  if (inputEl.value && inputEl.value !== "-") {
    ghost.style.display = 'none';
  } else {
    ghost.style.display = 'flex';
  }
}

function setupGlobalCopyPasteEvents() {
  document.addEventListener('mousedown', (e) => {
    const cell = e.target.closest('td.tab-cell');
    if (cell) {
      isMouseDown = true;
      startCell = cell;
      clearSelection();
      selectCellRange(startCell, cell);
    } else {
      if (!e.target.closest('.tab-table')) clearSelection();
    }
  });

  document.addEventListener('mouseover', (e) => {
    if (!isMouseDown || !startCell) return;
    const cell = e.target.closest('td.tab-cell');
    if (cell && cell.closest('tbody') === startCell.closest('tbody')) {
      selectCellRange(startCell, cell);
    }
  });

  document.addEventListener('mouseup', () => { isMouseDown = false; });

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'c') {
      if (currentSelection.length > 0) copySelectionToClipboard();
    }
    if ((e.ctrlKey || e.metaKey) && e.key === 'v') {
      if (currentSelection.length > 0 && copiedMatrix.length > 0) {
        pasteClipboardToSelection();
        e.preventDefault();
      }
    }
  });
}

function clearSelection() {
  for (const td of currentSelection) td.classList.remove('selected-cell');
  currentSelection = [];
}

function selectCellRange(cellA, cellB) {
  clearSelection();
  const tbody = cellA.closest('tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));
  const rowA = cellA.closest('tr').rowIndex;
  const colA = cellA.cellIndex;
  const rowB = cellB.closest('tr').rowIndex;
  const colB = cellB.cellIndex;

  const minRow = Math.min(rowA, rowB), maxRow = Math.max(rowA, rowB);
  const minCol = Math.min(colA, colB), maxCol = Math.max(colA, colB);

  for (let r = minRow; r <= maxRow; r++) {
    const tr = rows[r];
    for (let c = minCol; c <= maxCol; c++) {
      const td = tr.cells[c];
      if (td && td.classList.contains('tab-cell')) {
        td.classList.add('selected-cell');
        currentSelection.push(td);
      }
    }
  }
}

function copySelectionToClipboard() {
  copiedMatrix = [];
  if (currentSelection.length === 0) return;
  const rowMap = {};
  for (const td of currentSelection) {
    const rIdx = td.closest('tr').rowIndex;
    if (!rowMap[rIdx]) rowMap[rIdx] = [];
    rowMap[rIdx].push(td);
  }
  const sortedRowKeys = Object.keys(rowMap).sort((a,b) => a - b);
  for (const rKey of sortedRowKeys) {
    const tds = rowMap[rKey].sort((a,b) => a.cellIndex - b.cellIndex);
    const rowValues = tds.map(td => {
      const inp = td.querySelector('.tab-input');
      return inp ? inp.value : "-";
    });
    copiedMatrix.push(rowValues);
  }
}

function pasteClipboardToSelection() {
  if (copiedMatrix.length === 0 || currentSelection.length === 0) return;
  const startTd = currentSelection[0];
  const tbody = startTd.closest('tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));
  const startRowIdx = startTd.closest('tr').rowIndex;
  const startColIdx = startTd.cellIndex;

  for (let r = 0; r < copiedMatrix.length; r++) {
    const targetRowIdx = startRowIdx + r;
    if (targetRowIdx >= rows.length) break;
    const tr = rows[targetRowIdx];
    const rowData = copiedMatrix[r];
    for (let c = 0; c < rowData.length; c++) {
      const targetColIdx = startColIdx + c;
      if (targetColIdx >= tr.cells.length) break;
      const td = tr.cells[targetColIdx];
      if (td && td.classList.contains('tab-cell')) {
        const inp = td.querySelector('.tab-input');
        if (inp) {
          inp.value = rowData[c];
          formatCapoInput(inp);
          updateGhostGuide(inp);
          checkAndExpandColumns(inp);
        }
      }
    }
  }
}

function addPartToSection(secId) {
  const sCard = document.querySelector(`.section-card[data-section-id="${secId}"]`);
  const chordRow = sCard.querySelector('.chord-header-row');
  const totalSteps = chordRow.querySelectorAll('th').length - 1;
  const partsContainer = sCard.querySelector('.parts-container');
  const existingParts = partsContainer.querySelectorAll('.part-card');
  const partCount = existingParts.length + 1;
  
  const currentTuning = getLastUsedTuning();
  const newPart = { id: "part_" + Date.now(), name: "gt" + partCount, tuning: currentTuning, grid: {} };

  let prevPartData = null;
  if (existingParts.length > 0) {
    const lastPartCard = existingParts[existingParts.length - 1];
    prevPartData = { grid: {} };
    const rows = lastPartCard.querySelectorAll('tbody tr');
    for (let rIdx = 0; rIdx < rows.length; rIdx++) {
      const inputs = rows[rIdx].querySelectorAll('.tab-input');
      prevPartData.grid[rIdx] = [];
      for (const inp of inputs) prevPartData.grid[rIdx].push(inp.value);
    }
  }
  renderPartUI(partsContainer, newPart, prevPartData, totalSteps);
}

function insertStringRow(btnEl) {
  const tr = btnEl.closest('tr');
  const sCard = btnEl.closest('.section-card');
  const chordRow = sCard.querySelector('.chord-header-row');
