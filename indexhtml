  if (song.chordFormInputText !== undefined) {
    document.getElementById('chord-form-input').value = song.chordFormInputText;
  }
  if (Array.isArray(song.chordFormCards) && song.chordFormCards.length > 0) {
    chordFormCards = song.chordFormCards;
  } else {
    generateChordFormsFromInput();
  }
  renderChordCardsUI();

  const secContainer = document.getElementById('sections-container');
  secContainer.innerHTML = "";

  for (const sec of (song.sections || [])) {
    renderSectionUI(sec);
  }

  document.getElementById('page-list').classList.remove('active');
  document.getElementById('page-edit').classList.add('active');
  document.getElementById('ascii-output-container').style.display = 'none';
}

function getLastUsedTuning() {
  const partCards = document.querySelectorAll('.part-card');
  if (partCards.length > 0) {
    const lastCard = partCards[partCards.length - 1];
    const stringSelects = lastCard.querySelectorAll('.string-select');
    if (stringSelects.length > 0) {
      return Array.from(stringSelects).map(select => select.value);
    }
  }
  return [...DEFAULT_TUNING];
}

function renderSectionUI(sec) {
