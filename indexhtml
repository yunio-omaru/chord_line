}

async function saveToGitHub() {
  collectFormData();
  const path = localStorage.getItem('gh_filepath') || 'backup.json';
  const token = localStorage.getItem('gh_token');

  if (!token) {
    alert("GitHubのPersonal Access Tokenが未設定です。⚙️ ボタンから設定してください。");
    openGitHubSettings();
    return;
  }

  const btn = document.getElementById('btn-gh-save');
  btn.disabled = true;
  btn.innerText = "⏳ コミット中...";

  try {
    const url = `https://api.github.com/repos/${GITHUB_USER}/${GITHUB_REPO}/contents/${path}`;
    let sha = "";
    const getRes = await fetch(url, { headers: { "Authorization": `token ${token}` } });
    if (getRes.ok) {
      const getJson = await getRes.json();
      sha = getJson.sha;
    }

    const contentString = JSON.stringify(appData, null, 2);
    const contentBase64 = btoa(unescape(encodeURIComponent(contentString)));

    const bodyData = {
      message: `Auto backup: ${new Date().toLocaleString('ja-JP')}`,
      content: contentBase64
    };
    if (sha) bodyData.sha = sha;

    const putRes = await fetch(url, {
      method: "PUT",
      headers: {
        "Authorization": `token ${token}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify(bodyData)
    });

    if (putRes.ok) {
      alert(`✅ GitHub (${GITHUB_REPO}/${path}) にバックアップJSONを更新保存しました！`);
    } else {
      const errJson = await putRes.json();
      alert(`❌ GitHub保存エラー: ${errJson.message}`);
    }
  } catch (e) {
    console.error(e);
    alert("❌ GitHub保存中にエラーが発生しました");
  } finally {
    btn.disabled = false;
    btn.innerText = "🐙 GitHub保存";
  }
}

// 📝 画面の入力値をappDataに集約する (拡張)
function collectFormData() {
  if (!currentSongId) return;

  let song = null;
  for (const s of appData.songs) {
    if (s.id === currentSongId) {
      song = s;
      break;
    }
  }
  if (!song) return;

  song.artist = document.getElementById('song-artist').value;
  song.title = document.getElementById('song-title').value;
  song.bpm = document.getElementById('song-bpm').value;
  song.tuning = document.getElementById('song-tuning').value;
  song.capo = document.getElementById('song-capo').value;

  // コードフォーム表のデータ保存
  song.chordFormInputText = document.getElementById('chord-form-input').value;
  song.chordFormCards = chordFormCards;

  const sectionCards = document.querySelectorAll('.section-card');
  const sections = [];

  for (const sCard of sectionCards) {
    const secId = sCard.dataset.sectionId;
    const secName = sCard.querySelector('.section-name').value;
    const memo = sCard.querySelector('.section-memo').value;

    const chordInputs = sCard.querySelectorAll('.chord-input');
    const chords = [];
    for (const cIn of chordInputs) {
      chords.push(cIn.value);
    }

    const partCards = sCard.querySelectorAll('.part-card');
    const parts = [];

    for (const pCard of partCards) {
      const partId = pCard.dataset.partId;
      const partName = pCard.querySelector('.part-name-input').value;

      const rows = pCard.querySelectorAll('tbody tr');
      const tuning = [];
      const grid = {};

      for (let rIdx = 0; rIdx < rows.length; rIdx++) {
        const row = rows[rIdx];
        const stringSelect = row.querySelector('.string-select');
        tuning.push(stringSelect ? stringSelect.value : "E");

        grid[rIdx] = [];
        const inputs = row.querySelectorAll('.tab-input');
        for (let step = 0; step < inputs.length; step++) {
          grid[rIdx].push(inputs[step] ? inputs[step].value : "-");
        }
      }

      parts.push({
        id: partId,
        name: partName,
        tuning: tuning,
        grid: grid
      });
    }

    sections.push({
      id: secId,
      name: secName,
      memo: memo,
      chords: chords,
      parts: parts
    });
  }

  song.sections = sections;
}

// 💻 データを画面に描写する (拡張)
function renderApp() {
  renderSongList();
  if (currentSongId) {
    const song = appData.songs.find(s => s.id === currentSongId);
    if (song) {
      if (song.chordFormInputText !== undefined) {
        document.getElementById('chord-form-input').value = song.chordFormInputText;
      }
      if (Array.isArray(song.chordFormCards) && song.chordFormCards.length > 0) {
        chordFormCards = song.chordFormCards;
      } else {
        generateChordFormsFromInput();
      }
      renderChordCardsUI();
    }
  }
}

function renderSongList() {
  const listEl = document.getElementById('song-list-container');
  const keyword = document.getElementById('search-box').value.toLowerCase();
  listEl.innerHTML = "";

  for (const song of appData.songs) {
    const matchArtist = (song.artist || "").toLowerCase().includes(keyword);
    const matchTitle = (song.title || "").toLowerCase().includes(keyword);

    if (matchArtist || matchTitle) {
      const li = document.createElement('li');
      li.className = 'song-item';
      li.onclick = () => openEditPage(song.id);
      li.innerHTML = `
        <div>
          <div class="song-artist">${song.artist || '（未設定の歌手）'}</div>
          <div class="song-title-text">${song.title || '（無題の曲）'}</div>
        </div>
        <button class="btn-danger btn-sm" onclick="event.stopPropagation(); deleteSong('${song.id}')">削除</button>
      `;
      listEl.appendChild(li);
    }
  }
}

