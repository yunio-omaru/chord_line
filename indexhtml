function generateAsciiTab() {
  collectFormData();
  const song = appData.songs.find(s => s.id === currentSongId);
  if (!song) return;

  let ascii = `Artist: ${song.artist || 'Unknown'}\n`;
  ascii += `Title: ${song.title || 'Untitled'}\n`;
  ascii += `BPM: ${song.bpm} | Tuning: ${song.tuning} | CAPO: ${song.capo}\n`;
  ascii += `===========================================\n\n`;

  for (const sec of (song.sections || [])) {
    ascii += `[${sec.name}]\n`;
    if (sec.memo) ascii += `Memo: ${sec.memo}\n`;

    if (sec.chords && sec.chords.some(c => c !== "")) {
      ascii += `Chord: |`;
      for (let i = 0; i < sec.chords.length; i++) {
        ascii += ` ${(sec.chords[i] || '').padEnd(4, ' ')}|`;
      }
      ascii += `\n`;
    }

    for (const part of (sec.parts || [])) {
      ascii += `<${part.name}>\n`;
      const tuning = part.tuning || DEFAULT_TUNING;
      for (let sIdx = 0; sIdx < tuning.length; sIdx++) {
        let line = `${(tuning[sIdx] || 'E').padEnd(2, ' ')}|`;
        const colCount = (part.grid[sIdx]) ? part.grid[sIdx].length : 8;
        for (let step = 0; step < colCount; step++) {
          let val = (part.grid[sIdx] && part.grid[sIdx][step]) ? part.grid[sIdx][step] : "-";
          if (val === "") val = "-";
          line += `-${val.toString().padEnd(3, '-')}`;
        }
        line += "|\n";
        ascii += line;
      }
    }
    ascii += "\n";
  }

  const container = document.getElementById('ascii-output-container');
  const textEl = document.getElementById('ascii-text');
  textEl.innerText = ascii;
  container.style.display = 'block';

  navigator.clipboard.writeText(ascii).then(() => {
    alert("TuxGuitar / ASCII形式テキストをクリップボードにコピーしました！");
  }).catch(() => {});
}

// 📤 スプレッドシートへデータを書き込む (POST - 骨組み厳守)
async function saveToSpreadsheet() {
  const statusLabel = document.getElementById('sync-status');
  statusLabel.innerText = "💾 クラウドに保存中...";
  try {
    const res = await fetch(GAS_API_URL, {
      method: "POST",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: JSON.stringify(appData)
    });
    if (res.ok) {
      statusLabel.innerText = "✅ スプレッドシートに保存しました！";
    } else {
      statusLabel.innerText = "❌ クラウド保存エラー(ステータス不正)";
    }
  } catch(e) {
    console.error(e);
    statusLabel.innerText = "❌ クラウド保存エラー";
  }
}
</script>
