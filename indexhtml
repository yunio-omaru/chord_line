// 🎸 フォーム解析・生成ロジック
function parseChordName(raw) {
  if (!raw) return null;
  const cleaned = raw.trim().replace(/♭/g, "b").replace(/♯/g, "#").replace(/△/g, "M").replace(/maj/g, "M");
  const match = cleaned.match(/^([A-G][#b]?)(.*)$/);
  if (!match) return null;

  const root = match[1];
  let suffix = match[2];

  if (suffix === "" || suffix === "M") suffix = "M";
  else if (suffix === "m" || suffix === "min") suffix = "m";
  else if (suffix === "7") suffix = "7";
  else if (suffix === "M7") suffix = "M7";
  else if (suffix === "m7" || suffix === "min7") suffix = "m7";
  else if (suffix === "6") suffix = "6";
  else if (suffix === "add9") suffix = "add9";
  else if (suffix === "sus4") suffix = "sus4";
  else if (suffix === "dim" || suffix === "dim7") suffix = "dim";
  else if (suffix === "m7b5" || suffix === "m7-5" || suffix === "ø") suffix = "m7b5";
  else suffix = "M";

  return { root, suffix, normalized: root + (suffix === "M" ? "" : suffix) };
}

function getChordVariants(chordStr) {
  const parsed = parseChordName(chordStr);
  if (!parsed) return [];

  const { root, suffix, normalized } = parsed;
  const rootSemi = NOTE_TO_SEMI[root];
  if (rootSemi === undefined) return [];

  const variants = [];
  const fret5 = (rootSemi - STRING5_OPEN + 12) % 12;
  const fret6 = (rootSemi - STRING6_OPEN + 12) % 12;

  const tmpl5 = FORM_TEMPLATES["5_" + suffix];
  const tmpl6 = FORM_TEMPLATES["6_" + suffix];

  const makeVariant = (tmpl, baseFret) => {
    const frets = tmpl.offsets.map(off => (off === "x" ? "x" : baseFret + off));
    return {
      label: `${tmpl.label} (${tmpl.rootString}弦${baseFret}F)`,
      frets
    };
  };

  const openList = OPEN_CHORDS[normalized] || [];

  if (fret6 === 0 && tmpl6) {
    variants.push(makeVariant(tmpl6, 0));
    if (tmpl5) variants.push(makeVariant(tmpl5, fret5));
  } else if (openList.length > 0 && (root === "G" || root === "C" || root === "D")) {
    for (const o of openList) variants.push({ label: o.label, frets: [...o.frets] });
    if (tmpl5) variants.push(makeVariant(tmpl5, fret5));
    if (tmpl6) variants.push(makeVariant(tmpl6, fret6));
  } else {
    if (tmpl5) variants.push(makeVariant(tmpl5, fret5));
    if (tmpl6) variants.push(makeVariant(tmpl6, fret6));
    for (const o of openList) variants.push({ label: o.label, frets: [...o.frets] });
  }

  if (variants.length === 0 && tmpl5) variants.push(makeVariant(tmpl5, fret5));
  return variants;
}

function calcStartFret(frets) {
  const nums = frets.filter(f => typeof f === "number" && f > 0);
  if (nums.length === 0) return 1;
  const maxF = Math.max(...nums);
  return maxF <= 4 ? 1 : Math.min(...nums);
}

function createChordCard(chordName) {
  const variants = getChordVariants(chordName);
  const card = {
    chordName: chordName.trim(),
    variants,
    variantIndex: 0,
    startFret: 1,
    strings: Array.from({ length: 6 }, () => ({ state: "none", fret: null, manual: false }))
  };
  if (variants.length > 0) applyVariantToChordCard(card, 0);
  return card;
}

function addEmptyChordCard() {
  chordFormCards.push({
    chordName: "",
    variants: [],
    variantIndex: 0,
    startFret: 1,
    strings: Array.from({ length: 6 }, () => ({ state: "none", fret: null, manual: false }))
  });
  renderChordCardsUI();
}

function applyVariantToChordCard(card, variantIndex) {
  if (!card.variants || !card.variants[variantIndex]) return;
  card.variantIndex = variantIndex;
  const frets = card.variants[variantIndex].frets;
  card.startFret = calcStartFret(frets);
  card.strings = frets.map(f => {
    if (f === "x") return { state: "mute", fret: null, manual: false };
    if (f === 0) return { state: "open", fret: 0, manual: false };
    return { state: "fret", fret: f, manual: false };
  });
}

function generateChordFormsFromInput() {
  const text = document.getElementById('chord-form-input').value;
  const tokens = text.split(/[\s,、]+/).filter(Boolean);
  if (tokens.length === 0) {
    chordFormCards = [createChordCard("")];
  } else {
    chordFormCards = [];
    for (const t of tokens) {
      chordFormCards.push(createChordCard(t));
    }
  }
  renderChordCardsUI();
}

function renderChordCardsUI() {
  const container = document.getElementById('chord-cards-container');
  if (!container) return;
  container.innerHTML = "";

  for (let cIdx = 0; cIdx < chordFormCards.length; cIdx++) {
    const card = chordFormCards[cIdx];
    const el = document.createElement("div");
    el.className = "chord-card";

    // 上部 ＋ / － ボタン
    const topActions = document.createElement("div");
    topActions.className = "card-top-actions";

    const addBtn = document.createElement("button");
    addBtn.type = "button";
    addBtn.className = "mini-btn";
    addBtn.textContent = "+";
    addBtn.onclick = () => {
      chordFormCards.splice(cIdx + 1, 0, createChordCard(""));
      renderChordCardsUI();
    };

    const removeBtn = document.createElement("button");
    removeBtn.type = "button";
    removeBtn.className = "mini-btn";
    removeBtn.textContent = "-";
    removeBtn.onclick = () => {
      chordFormCards.splice(cIdx, 1);
      if (chordFormCards.length === 0) chordFormCards.push(createChordCard(""));
      renderChordCardsUI();
    };

    topActions.append(addBtn, removeBtn);
    el.appendChild(topActions);

    // ヘッダー
    const header = document.createElement("div");
    header.className = "chord-card-header";

    const leftInfo = document.createElement("div");
    const nameInput = document.createElement("input");
    nameInput.type = "text";
    nameInput.className = "chord-name-field";
    nameInput.value = card.chordName;
    nameInput.placeholder = "コード";
    nameInput.onchange = (e) => {
      card.chordName = e.target.value.trim();
      card.variants = getChordVariants(card.chordName);
      if (card.variants.length > 0) applyVariantToChordCard(card, 0);
      renderChordCardsUI();
    };

    const badge = document.createElement("span");
    badge.className = "variant-badge";
    badge.textContent = (card.variants && card.variants[card.variantIndex]) ? card.variants[card.variantIndex].label : "";

    leftInfo.append(nameInput, badge);

    const dropBtn = document.createElement("button");
    dropBtn.type = "button";
    dropBtn.className = "dropdown-btn";
    dropBtn.textContent = "▼";

    const menu = document.createElement("div");
    menu.className = "dropdown-menu";

    if (card.variants && card.variants.length > 0) {
      for (let vIdx = 0; vIdx < card.variants.length; vIdx++) {
        const v = card.variants[vIdx];
        const item = document.createElement("div");
        item.className = "dropdown-item" + (vIdx === card.variantIndex ? " active" : "");
        item.textContent = v.label;
        item.onclick = (ev) => {
          ev.stopPropagation();
          applyVariantToChordCard(card, vIdx);
          renderChordCardsUI();
        };
        menu.appendChild(item);
      }
    } else {
      const emptyItem = document.createElement("div");
      emptyItem.className = "dropdown-item";
      emptyItem.textContent = "候補なし";
      menu.appendChild(emptyItem);
    }

    dropBtn.onclick = (ev) => {
      ev.stopPropagation();
      document.querySelectorAll(".dropdown-menu.open").forEach(m => {
        if (m !== menu) m.classList.remove("open");
      });
      menu.classList.toggle("open");
    };

    header.append(leftInfo, dropBtn, menu);
    el.appendChild(header);

    // 指板本体
    const wrapper = document.createElement("div");
    wrapper.className = "fretboard-wrapper";

    const startLabel = document.createElement("div");
    startLabel.className = "start-fret-label";
    startLabel.textContent = card.startFret > 1 ? card.startFret : "";
    wrapper.appendChild(startLabel);

    const table = document.createElement("table");
    table.className = "fretboard-table";

    const numRow = document.createElement("tr");
    numRow.className = "fret-num-row";
    numRow.appendChild(document.createElement("td"));
    for (let col = 0; col < 4; col++) {
      const td = document.createElement("td");
      td.textContent = (card.startFret + col) + "F";
      numRow.appendChild(td);
    }
    table.appendChild(numRow);

    for (let s = 0; s < 6; s++) {
      const tr = document.createElement("tr");
      const sData = card.strings[s] || { state: "none", fret: null, manual: false };

      const openTd = document.createElement("td");
      openTd.className = "open-cell" + (card.startFret > 1 ? " no-nut" : "");
      if (sData.state === "open" || sData.state === "mute") {
        const mark = document.createElement("span");
        mark.className = "open-mark" + (sData.manual ? " manual" : "");
        mark.textContent = sData.state === "open" ? "o" : "x";
        openTd.appendChild(mark);
      }
      openTd.onclick = () => {
        if (sData.state === "open") card.strings[s] = { state: "mute", fret: null, manual: true };
        else if (sData.state === "mute") card.strings[s] = { state: "none", fret: null, manual: true };
        else card.strings[s] = { state: "open", fret: 0, manual: true };
        renderChordCardsUI();
      };
      tr.appendChild(openTd);

      for (let col = 0; col < 4; col++) {
        const fretNum = card.startFret + col;
        const fTd = document.createElement("td");
        fTd.className = "fret-cell";
        if (sData.state === "fret" && sData.fret === fretNum) {
          const dot = document.createElement("div");
          dot.className = "finger-dot" + (sData.manual ? " manual" : "");
          fTd.appendChild(dot);
        }
        fTd.onclick = () => {
          if (sData.state === "fret" && sData.fret === fretNum) {
            card.strings[s] = { state: "none", fret: null, manual: true };
          } else {
            card.strings[s] = { state: "fret", fret: fretNum, manual: true };
          }
          renderChordCardsUI();
        };
        tr.appendChild(fTd);
      }
      table.appendChild(tr);
    }
    wrapper.appendChild(table);
    el.appendChild(wrapper);

    // フッター
    const footer = document.createElement("div");
    footer.className = "chord-card-footer";

    const shiftWrap = document.createElement("div");
    const pBtn = document.createElement("button");
    pBtn.type = "button";
    pBtn.className = "mini-btn";
    pBtn.textContent = "◀";
    pBtn.onclick = () => { if (card.startFret > 1) { card.startFret--; renderChordCardsUI(); } };

    const nBtn = document.createElement("button");
    nBtn.type = "button";
    nBtn.className = "mini-btn";
    nBtn.textContent = "▶";
    nBtn.onclick = () => { if (card.startFret < 12) { card.startFret++; renderChordCardsUI(); } };

    shiftWrap.append(pBtn, nBtn);

    const clrBtn = document.createElement("button");
    clrBtn.type = "button";
    clrBtn.className = "mini-btn";
    clrBtn.style.width = "auto";
    clrBtn.style.padding = "2px 6px";
    clrBtn.textContent = "クリア";
    clrBtn.onclick = () => {
      card.strings = Array.from({ length: 6 }, () => ({ state: "none", fret: null, manual: true }));
      renderChordCardsUI();
    };

    footer.append(shiftWrap, clrBtn);
    el.appendChild(footer);

    container.appendChild(el);
  }
}

