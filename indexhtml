// 既存の通信・保存・読み込みロジック (骨組み厳守)
async function loadFromSpreadsheet() {
  const statusLabel = document.getElementById('sync-status');
  statusLabel.innerText = "🔄 スプレッドシートからデータを同期中...";
  try {
    const res = await fetch(GAS_API_URL);
    if(res.ok) {
      const data = await res.json();
      if (data && data.songs) {
        appData = data;
      }
      statusLabel.innerText = "✅ 同期完了";
      renderApp();
    } else {
      statusLabel.innerText = "⚠️ データレスポンスエラー";
      renderApp();
    }
  } catch(e) {
    console.error(e);
    statusLabel.innerText = "❌ 読み込み同期エラー";
    renderApp();
  }
}

async function executeSave() {
  const saveBtn = document.getElementById('btn-save');
  saveBtn.disabled = true;
  saveBtn.innerText = "⏳ 保存中...";
  try {
    collectFormData();
    await saveToSpreadsheet();
  } catch (e) {
    console.error(e);
    alert("保存処理でエラーが発生しました");
  } finally {
    saveBtn.disabled = false;
    saveBtn.innerText = "💾 保存";
  }
}

