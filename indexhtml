  secContainer.appendChild(card);

  const partsContainer = card.querySelector('.parts-container');
  const currentTuning = getLastUsedTuning();
  const parts = (sec.parts && sec.parts.length > 0) ? sec.parts : [{ id: "part_" + Date.now(), name: "gt1", tuning: currentTuning, grid: {} }];
  
  for (let pIdx = 0; pIdx < parts.length; pIdx++) {
    const prevPart = (pIdx > 0) ? parts[pIdx - 1] : null;
    renderPartUI(partsContainer, parts[pIdx], prevPart, totalSteps);
