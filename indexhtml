function createNoteOptionsHtml(selectedNote) {
  let html = "";
  let options = [...NOTE_OPTIONS];
  if (selectedNote && !options.includes(selectedNote)) {
    options.unshift(selectedNote);
  }
  for (const note of options) {
    const isSelected = (note === selectedNote) ? 'selected' : '';
    html += `<option value="${note}" ${isSelected}>${note}</option>`;
  }
  return html;
}

function renderPartUI(partsContainer, part, prevPart = null, totalSteps = 8) {
  const partId = part.id || "part_" + Date.now() + "_" + Math.random().toString(36).substr(2, 4);
  const partCard = document.createElement('div');
  partCard.className = "part-card";
  partCard.dataset.partId = partId;

  const tuning = part.tuning || getLastUsedTuning();

  let tabCols = '<col class="control-col">';
  for (let i = 0; i < totalSteps; i++) {
    tabCols += '<col class="tab-cell-col">';
  }

  let tabRowsHtml = "";
  for (let sIdx = 0; sIdx < tuning.length; sIdx++) {
    tabRowsHtml += createStringRowHtml(sIdx, tuning[sIdx], part, prevPart, totalSteps);
  }

  partCard.innerHTML = `
    <div class="part-header">
      <div>
        ＜<input type="text" class="part-name-input" value="${part.name || 'gt1'}">＞
        <button type="button" class="btn-secondary btn-sm" onclick="appendStringBottom('${partId}')">＋ 弦追加</button>
      </div>
      <button type="button" class="btn-danger btn-sm" onclick="this.closest('.part-card').remove()">パート削除</button>
    </div>

    <div class="tab-grid-wrapper">
      <table class="tab-table">
        <colgroup>${tabCols}</colgroup>
        <tbody>
          ${tabRowsHtml}
        </tbody>
